RewriteEngine On

# Eski hatalı sayfaları ana sayfaya yönlendir
RewriteRule ^fiber-kablo-tamiri/?$ / [R=301,L]
RewriteRule ^fiber-kablo-tamiri/(.*)$ / [R=301,L]
RewriteRule ^contact-2/?$ / [R=301,L]
RewriteRule ^contact-2/(.*)$ / [R=301,L]
RewriteRule ^iletisim/?$ / [R=301,L]
RewriteRule ^iletisim/(.*)$ / [R=301,L]
RewriteRule ^hakkimizda/?$ / [R=301,L]
RewriteRule ^hakkimizda/(.*)$ / [R=301,L]
RewriteRule ^hizmetlerimiz/?$ /#services [R=301,L,NE]
RewriteRule ^hizmetlerimiz/(.*)$ /#services [R=301,L,NE]
RewriteRule ^blog/?$ / [R=301,L]
RewriteRule ^blog/(.*)$ / [R=301,L]
RewriteRule ^kategori/(.*)$ / [R=301,L]
RewriteRule ^wp-content/(.*)$ / [R=301,L]
RewriteRule ^wp-admin/(.*)$ / [R=301,L]
RewriteRule ^wp-includes/(.*)$ / [R=301,L]
RewriteRule ^tag/(.*)$ / [R=301,L]
RewriteRule ^author/(.*)$ / [R=301,L]
RewriteRule ^page/(.*)$ / [R=301,L]
RewriteRule ^feed/(.*)$ / [R=301,L]

# Tüm diğer bilinmeyen URL'leri ana sayfaya yönlendir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ / [R=301,L]

# 404 yönlendirme
ErrorDocument 404 /index.html

# Sıkıştırma
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
</IfModule>

# Önbellekleme
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
