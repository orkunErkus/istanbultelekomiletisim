RewriteEngine On

# HTTPS zorla (yorum satırını kaldırın)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Eski hatalı sayfaları ana sayfaya yönlendir
RewriteRule ^fiber-kablo-tamiri/?$ / [R=301,L]
RewriteRule ^fiber-kablo-tamiri/(.*)$ / [R=301,L]
RewriteRule ^contact-2/?$ / [R=301,L]
RewriteRule ^contact-2/(.*)$ / [R=301,L]
RewriteRule ^iletisim/?$ / [R=301,L]
RewriteRule ^iletisim/(.*)$ / [R=301,L]
RewriteRule ^hakkimizda/?$ / [R=301,L]
RewriteRule ^hakkimizda/(.*)$ / [R=301,L]
RewriteRule ^hizmetlerimiz/?$ /#services [R=301,L,NE]
RewriteRule ^hizmetlerimiz/(.*)$ /#services [R=301,L,NE]
RewriteRule ^blog/?$ / [R=301,L]
RewriteRule ^blog/(.*)$ / [R=301,L]
RewriteRule ^kategori/(.*)$ / [R=301,L]
RewriteRule ^wp-content/(.*)$ / [R=301,L]
RewriteRule ^wp-admin/(.*)$ / [R=301,L]
RewriteRule ^wp-includes/(.*)$ / [R=301,L]
RewriteRule ^tag/(.*)$ / [R=301,L]
RewriteRule ^author/(.*)$ / [R=301,L]
RewriteRule ^page/(.*)$ / [R=301,L]
RewriteRule ^feed/(.*)$ / [R=301,L]

# Tüm diğer bilinmeyen URL'leri ana sayfaya yönlendir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ / [R=301,L]

# 404 yönlendirme
ErrorDocument 404 /index.html

# === GÜVENLİK BAŞLIKLARI ===
<IfModule mod_headers.c>
    # Clickjacking koruma
    Header always set X-Frame-Options "SAMEORIGIN"
    # XSS koruma
    Header set X-XSS-Protection "1; mode=block"
    # MIME türü zorla
    Header set X-Content-Type-Options "nosniff"
    # Referrer politikası
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # HTTPS zorunlu (HSTS) — sadece HTTPS aktifse açın
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Dizin listeleme kapalı
Options -Indexes

# Hassas dosyaları koru
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "^(sw\.js|manifest\.json)$">
    Require all granted
</FilesMatch>

# Sıkıştırma
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

# Önbellekleme
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 1 week"
</IfModule>
